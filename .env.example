# Copy to .env (git-ignored) and fill in. Every variable is optional unless noted.

# --- Distributors ---
# Mouser Search API key (https://www.mouser.com/api-hub/). Empty -> Mouser reported as not configured.
MOUSER_API_KEY=
# TME API v2 credentials (OAuth2 client credentials). Empty -> TME reported as not configured.
TME_TOKEN=
TME_APPLICATION_SECRET=
# Country used for TME prices/stock (ISO 3166-1 alpha-2).
COUNTRY=RO

# --- Security ---
# dev = no login, every request runs as the fake "Development Admin"; prod = OIDC login + bearer tokens.
KINA_MODE=dev
# Public HTTPS origin as seen by clients (used in OAuth metadata/redirects). Empty -> derived from X-Forwarded-* headers.
KINA_PUBLIC_BASE_URL=
# Production OIDC provider (any compliant issuer; discovery via /.well-known/openid-configuration). Required when KINA_MODE=prod.
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Ranking (in-process cross-encoder, DESIGN.md 3.5) ---
# false -> deterministic ranking only (every search reports ranking "fallback").
KINA_CROSS_ENCODER_ENABLED=true
# int8 (default, ~25 MB, about 2x faster; the file matching the CPU is chosen) or fp32 (~90 MB).
KINA_CROSS_ENCODER_VARIANT=int8
# ONNX Runtime threads for one ranking call; 0 = min(4, available processors). Use physical cores only.
KINA_CROSS_ENCODER_THREADS=0
# Where the model files live. Compose sets /data/cross-encoder; locally the default is
# ${KINA_JLCPCB_DATA_DIR}/../cross-encoder (./data/cross-encoder).
# KINA_CROSS_ENCODER_MODEL_DIR=
# Source of the model files: a Hugging Face resolve URL or any HTTP(S) directory with the same layout, or a local
# directory used in place (e.g. a fine-tuned model from scripts/ranking/finetune_cross_encoder.sh).
# Default: https://huggingface.co/cross-encoder/ms-marco-MiniLM-L6-v2/resolve/main/
# KINA_CROSS_ENCODER_MODEL_URL=

# --- JLCPCB / LCSC parts database ---
# parts-fts5.db (all), current-parts-fts5.db or basic-parts-fts5.db.
KINA_JLCPCB_LIBRARY=parts-fts5.db
# KINA_JLCPCB_DATA_DIR is /data/jlcpcb in Docker (default ./data/jlcpcb when run locally).

# --- Runtime ---
# Host port for the kina service.
KINA_PORT=8080
# Memory limit of the kina container (JVM heap = 75% of it).
KINA_MEM_LIMIT=2g
# Outside compose only: HTTP port and database connection.
# PORT=8080
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kina
# SPRING_DATASOURCE_USERNAME=kina
# SPRING_DATASOURCE_PASSWORD=kina
