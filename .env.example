# Copy to .env (git-ignored) and fill in. Every variable is optional unless noted.

# --- Distributors ---
# Mouser Search API key (https://www.mouser.com/api-hub/). Empty -> Mouser reported as not configured.
MOUSER_API_KEY=
# TME API v2 credentials (OAuth2 client credentials). Empty -> TME reported as not configured.
TME_TOKEN=
TME_APPLICATION_SECRET=
# Country used for TME prices/stock (ISO 3166-1 alpha-2).
COUNTRY=RO

# --- Security ---
# dev = no login, every request runs as the fake "Development Admin"; prod = OIDC login + bearer tokens.
KINA_MODE=dev
# Public HTTPS origin as seen by clients (used in OAuth metadata/redirects). Empty -> derived from X-Forwarded-* headers.
KINA_PUBLIC_BASE_URL=
# Production OIDC provider (any compliant issuer; discovery via /.well-known/openid-configuration). Required when KINA_MODE=prod.
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Group authorisation (prod only, DESIGN.md 7.1) ---
# Comma-separated groups; a user must be in at least one. Empty -> no group check.
OIDC_REQUIRED_GROUPS=
# Optional comma-separated e-mail domains (e.g. alacrity.ro). Empty -> any domain.
OIDC_ALLOWED_EMAIL_DOMAINS=
# true: when the provider sends no "email" claim, use preferred_username (then upn) if it contains an @. Default: false
# OIDC_EMAIL_FROM_PREFERRED_USERNAME=false
# With OIDC_ALLOWED_EMAIL_DOMAINS: refuse an address the provider marks as unverified (email_verified=false).
# Set false only when the provider admits just accounts whose address the organisation controls (for example Google
# Workspace accounts through Authentik, restricted to your domain) and the provider does not maintain email_verified.
# Authentik's default "email" scope mapping always sends email_verified=false. The domain check still applies.
# Default: true
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# Claim holding the groups (ID token first, then userinfo; dotted path for nested claims). Default: groups
# OIDC_GROUPS_CLAIM=groups
# Extra scopes besides "openid profile email" (offline_access is added automatically when needed).
# OIDC_EXTRA_SCOPES=
# AES-GCM key for the identity provider's refresh tokens stored for membership re-checks: base64 of 32 bytes
# (openssl rand -base64 32). Unset -> no server-side re-checks; users must sign in again every
# KINA_RELOGIN_INTERVAL_WITHOUT_RECHECK (24h) to keep refreshing. Never commit a real key.
KINA_TOKEN_ENCRYPTION_KEY=
# Uncomment to change (an empty value is not a valid duration):
# KINA_MEMBERSHIP_RECHECK_INTERVAL=1h
# KINA_MEMBERSHIP_GRACE=4h
# KINA_RELOGIN_INTERVAL_WITHOUT_RECHECK=24h

# --- OAuth for Claude (DESIGN.md 7) ---
# Uncomment to change:
# KINA_OAUTH_ACCESS_TOKEN_VALIDITY=1h
# KINA_OAUTH_REFRESH_TOKEN_VALIDITY=30d
# Hosts whose https client_id URLs (Client ID Metadata Documents) are accepted; *.example.com = subdomains.
# KINA_OAUTH_TRUSTED_CLIENT_HOSTS=claude.ai,claude.com,*.anthropic.com
# Skip the consent page for those clients (non-loopback redirect URIs only).
# KINA_OAUTH_AUTO_APPROVE_TRUSTED_CLIENTS=true
# POST /oauth/register requests per client IP and minute (0 = unlimited).
# KINA_OAUTH_REGISTER_RATE_LIMIT_PER_MINUTE=30
# false -> the web UI only explains the Claude connector; personal static tokens cannot be created.
# KINA_TOKENS_UI_ENABLED=true

# --- Search (DESIGN.md 3.4) ---
# Hard constraints (never relaxed) per family; unset = the decided defaults (DESIGN.md 3.4 "Hard constraints").
# Families: resistor, capacitor, inductor, ferrite, crystal, oscillator, diode, led, transistor, regulator, connector,
# usb, fan, switch, default. Names: value, package, mounting, technology, elements, type, polarity, voltage, load
# capacitance, connector type, gender, positions, pitch, usb type, pin configuration, usb standard, fan type, frame size,
# led type, colour, wavelength, switch type, contacts, switch function, termination, switch size, hole diameter,
# switch positions, illumination, dielectric, tolerance, orientation, speed, bearing, lens, viewing angle,
# colour temperature, force. Setting a family replaces its whole list, e.g.:
# KINA_SEARCH_HARDCONSTRAINTS_INDUCTOR=type,value,mounting,technology,package
# Deprecated: a non-empty list drops mounting, technology or elements when they are missing (a warning is logged).
# KINA_STRICT_CONSTRAINTS=
# A part with less stock than this (or less than twice the requested quantity) is reported as low_stock and ranks lower.
# KINA_LOW_STOCK_THRESHOLD=10

# --- Cache (DESIGN.md 3.2 "Cache model", OPERATIONS.md "Distributor terms") ---
# Cached TME/Mouser search lists are searched again after this; stock and prices older than this that cannot be
# refreshed are returned with stale: true. Search lists are purged after twice this.
# KINA_CACHE_TTL=3d
# Cached TME/Mouser stock and prices older than this are refreshed (one cheap call) before a part is returned.
# KINA_CACHE_STOCK_TTL=24h
# How long a cached part's metadata is kept per distributor: forever (default) or a duration such as 3d. Set a
# duration to honour a distributor's notice; the purge (every 6 hours) then deletes older rows.
# KINA_CACHE_METADATA_RETENTION_TME=forever
# KINA_CACHE_METADATA_RETENTION_MOUSER=forever
# Score penalty of a part with stale stock and prices; 1.0 ranks every stale part below every fresh one.
# KINA_CACHE_STALE_RANK_PENALTY=1.0

# --- Ranking (in-process cross-encoder, DESIGN.md 3.5) ---
# false -> deterministic ranking only (every search reports ranking "fallback").
KINA_CROSS_ENCODER_ENABLED=true
# int8 (default, ~25 MB, about 2x faster; the file matching the CPU is chosen) or fp32 (~90 MB). Both are in the
# image unless it was built with --build-arg CROSS_ENCODER_VARIANTS=int8.
KINA_CROSS_ENCODER_VARIANT=int8
# ONNX Runtime threads for one ranking call; 0 = min(4, available processors). Use physical cores only.
KINA_CROSS_ENCODER_THREADS=0
# The Docker image bundles the model at /opt/kina/cross-encoder (verified at build time) and sets
# KINA_CROSS_ENCODER_MODEL_URL=/opt/kina/cross-encoder and KINA_CROSS_ENCODER_AUTO_DOWNLOAD=false: the container never
# downloads it. Leave the next three unset in Docker unless you replace the model.
# Source of the model files. A local directory is used in place, read only (e.g. a fine-tuned model from
# scripts/ranking/finetune_cross_encoder.sh copied to /data/cross-encoder-finetuned); a value set here overrides the
# bundled directory. An HTTP(S) directory with the Hugging Face layout (e.g. a mirror) is downloaded into
# KINA_CROSS_ENCODER_MODEL_DIR, in Docker only together with KINA_CROSS_ENCODER_AUTO_DOWNLOAD=true.
# Default outside Docker: https://huggingface.co/cross-encoder/ms-marco-MiniLM-L6-v2/resolve/main/
# KINA_CROSS_ENCODER_MODEL_URL=
# Download missing model files from an HTTP(S) KINA_CROSS_ENCODER_MODEL_URL. Default true; false in the Docker image.
# KINA_CROSS_ENCODER_AUTO_DOWNLOAD=
# Download target for an HTTP(S) source. Default ${KINA_JLCPCB_DATA_DIR}/../cross-encoder
# (./data/cross-encoder locally, /data/cross-encoder in Docker).
# KINA_CROSS_ENCODER_MODEL_DIR=

# --- JLCPCB / LCSC parts database ---
# parts-fts5.db (all), current-parts-fts5.db or basic-parts-fts5.db.
KINA_JLCPCB_LIBRARY=parts-fts5.db
# KINA_JLCPCB_DATA_DIR is /data/jlcpcb in Docker (default ./data/jlcpcb when run locally).

# --- Runtime ---
# Host port for the kina service.
KINA_PORT=8080
# Management port: actuator health and the Prometheus exporter (/actuator/prometheus, DESIGN.md 3.7).
# WARNING: this port has NO authentication. Never expose it publicly; let only your Prometheus reach it.
# Outside Docker it is the port KINA listens on (default 9090; it must differ from PORT). With compose it is the host
# port only (the container always listens on 9090).
KINA_METRICS_PORT=9090
# Compose only: host address the management port is published on. Default 127.0.0.1 (this host only); set the
# address of the monitoring network interface if Prometheus runs elsewhere, never 0.0.0.0 on a public host.
KINA_METRICS_BIND=127.0.0.1
# Metrics backfill (DESIGN.md 3.7): moves type="unknown" counts to the component types the cached searches and parts
# show. Spring cron in the JVM time zone (second minute hour day month weekday); default daily at 06:00. It also runs
# once at the first start against a database. false turns both off.
KINA_METRICS_BACKFILL_CRON=0 0 6 * * *
KINA_METRICS_BACKFILL_ENABLED=true
# Memory limit of the kina container (JVM heap = 75% of it).
KINA_MEM_LIMIT=2g
# Outside compose only: HTTP port and database connection.
# PORT=8080
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kina
# SPRING_DATASOURCE_USERNAME=kina
# SPRING_DATASOURCE_PASSWORD=kina
