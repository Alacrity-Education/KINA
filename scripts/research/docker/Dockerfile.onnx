# Research image: the KINA Laya image plus the packages the non-HTTP experiments need.
#   docker build -t kina-laya-research:onnx -f scripts/research/docker/Dockerfile.onnx scripts/research/docker
# (optimum pins transformers < 5, so this variant is used only for the ONNX Runtime latency check)
FROM kina-laya:v0.3.27
USER root
RUN /opt/venv/bin/pip install --no-cache-dir "sentence-transformers>=5,<6" "scikit-learn>=1.5" psutil "onnxruntime>=1.20" "onnx>=1.17" "optimum[onnxruntime]>=1.23" \
 && /opt/venv/bin/python -c "import torch, transformers, sentence_transformers, sklearn, onnxruntime; print(torch.__version__, transformers.__version__, sentence_transformers.__version__, sklearn.__version__, onnxruntime.__version__)"
USER laya
